# ─── SlyxUp Environment Variables ───────────────────────────────

# Node
NODE_ENV=development

# URLs
API_BASE_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Security
JWT_SECRET=your-jwt-secret-min-32-chars
ENCRYPTION_KEY=your-encryption-key-hex
CRON_SECRET=your-cron-secret

# Better Auth
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Email (Brevo)
BREVO_API_KEY=
EMAIL_FROM=SlyxUp <noreply@slyxup.online>
SUPPORT_EMAIL=SlyxUp Support <support@slyxup.online>

# Billing (Paddle)
PADDLE_ENVIRONMENT=sandbox
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_URL=

# Renderer
RENDERER_URL=http://localhost:3001
RENDERER_API_KEY=dev-renderer-key

# File Storage (R2)
R2_PUBLIC_URL_BASE=

# External APIs
PEXELS_API_KEY=
GEMINI_API_KEY=
