{
  "name": "slyxup",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @slyxup/backend dev",
    "dev:pages": "pnpm --filter @slyxup/auth-pages dev",
    "dev:dashboard": "pnpm --filter @slyxup/dashboard dev",
    "dev:all": "pnpm run /^dev:/",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @slyxup/database exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @slyxup/backend exec wrangler d1 migrations apply slyxauth --local",
    "db:push": "pnpm run db:generate && pnpm run db:migrate",
    "auth:gen-schema": "pnpm dlx @better-auth/cli@latest generate --config ./tooling/better-auth.config.ts --output ./packages/database/src/schema/auth.ts",
    "test": "vitest run && bash scripts/test.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.42.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
