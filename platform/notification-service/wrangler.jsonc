{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slyxup-notification",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ed01399ae5f7a46697e0802e4eaef6a9",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "slyxup-notification",
    "database_id": "4b164a23-a83d-4023-bf1d-0994e5cc0f7a",
    "migrations_dir": "migrations"
  }],
  "routes": [{ "pattern": "notification.slyxup.online", "custom_domain": true }],
  "vars": { "ENVIRONMENT": "production" }
}
