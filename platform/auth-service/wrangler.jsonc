{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slyxup-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ed01399ae5f7a46697e0802e4eaef6a9",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slyxup-auth",
      "database_id": "65fcc877-e0b6-4198-aff4-f0d1dff72d35",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "auth.slyxup.online", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_DOMAIN": "https://url.slyxup.online",
    "EMAIL_SERVICE_URL": "https://email.slyxup.online"
  }
}
