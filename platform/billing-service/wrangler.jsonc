{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slyxup-billing",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ed01399ae5f7a46697e0802e4eaef6a9",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "slyxup-billing",
    "database_id": "1c93dbc6-7939-4379-9faa-0372b3fbb2df",
    "migrations_dir": "migrations"
  }],
  "routes": [{ "pattern": "billing.slyxup.online", "custom_domain": true }],
  "vars": { "ENVIRONMENT": "production" }
}
