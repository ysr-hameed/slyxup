{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slyxup-storage",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ed01399ae5f7a46697e0802e4eaef6a9",
  "r2_buckets": [{
    "binding": "R2",
    "bucket_name": "slyxup-storage",
    "preview_bucket_name": "slyxup-storage-dev"
  }],
  "routes": [{ "pattern": "storage.slyxup.online", "custom_domain": true }],
  "vars": { "ENVIRONMENT": "production", "R2_PUBLIC_URL": "https://storage.slyxup.online" }
}
