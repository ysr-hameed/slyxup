{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slyxup-url-shortener",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ed01399ae5f7a46697e0802e4eaef6a9",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "slyxup-url-shortener",
    "database_id": "9764ea5a-6307-41e7-b43f-1b4fd76a5476",
    "migrations_dir": "migrations"
  }],
  "routes": [{ "pattern": "api-url.slyxup.online", "custom_domain": true }],
  "vars": { "ENVIRONMENT": "production" }
}
